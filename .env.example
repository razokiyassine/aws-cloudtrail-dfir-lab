# Copier en ".env" :  cp .env.example .env

# Image LocalStack. 4.14 = dernière version SANS compte/token (au moment de la rédaction du TP).
# Vérifier avant le cours :  docker pull localstack/localstack:4.14
LOCALSTACK_IMAGE=localstack/localstack:4.14

# Pour utiliser localstack/localstack:latest : compte gratuit "Hobby" (usage non commercial) + token
# https://app.localstack.cloud  -> LOCALSTACK_IMAGE=localstack/localstack:latest
LOCALSTACK_AUTH_TOKEN=

LOCALSTACK_DEBUG=0
LAB_REGION=eu-west-3

# Point d'accès AWS vu depuis le conteneur "lab".
#   LocalStack (défaut) : http://localstack:4566     |     Plan B moto : http://moto:4566
LAB_ENDPOINT=http://localstack:4566
